# Godot 4 cache and imports
.godot/
.import/
*.import.tmp

# Exports / builds
_builds/
_build/
export/
*.exe
*.pck
*.apk
*.aab
*.zip

# Godot editor files
*.translation
.mono/
data_*/
mono_crash.*.json

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Backups
*.bak
*.tmp

# raw/ y tools/ viven aqui desde el 2026-10-05 (Godot no los ve: llevan .gdignore).
# Va a git lo que no se puede rehacer: videos e imagenes fuente, scripts, notas,
# los sprites master (04_limpios) y las rejillas (05_salida). No va lo que los
# scripts de cada job regeneran solos desde el video, ni ffmpeg (se descarga).
__pycache__/
*.pyc
tools/ffmpeg/
raw/master_builder/anim/*/01_frames/
raw/master_builder/anim/*/02_contacto/
raw/master_builder/anim/*/03_seleccion/
# los fotogramas sin el objeto de relleno (quitar_objeto.py los rehace de 01_frames)
raw/master_builder/anim/*/01b_sin_objeto/
raw/master_builder/anim/*/_con_fondo/
raw/master_builder/anim/*/_sin_escalar/
raw/master_builder/anim/*/_todos/
# Tampoco las copias de antes de cada paso ni las versiones descartadas (siguen
# en el disco; si hacen falta, se suben aparte).
raw/master_builder/anim/_archivo/
raw/master_builder/anim/*/_sin_*/
raw/master_builder/anim/*/_con_sombra/
raw/master_builder/anim/*/_sobrantes/
raw/master_builder/anim/*/_vistas/
raw/master_builder/anim/*/04_limpios_original/
raw/master_builder/anim/*/hojas_antes/
raw/master_builder/anim/*/_*/
# Los fotogramas finales de las acciones de perfil: montar_accion.py los rehace
# de 04_limpios (con la tabla de cada job); la hoja va en 05_salida.
raw/master_builder/anim/*/04_acciones/

# Blender portable y su entorno de Python (bpy) para raw/master_builder/peregrino3d:
# ~1,8 GB que se descargan, como ffmpeg. Las copias de seguridad de Blender, tampoco.
tools/blender/
tools/bpy_env/
*.blend1

# Arneses de un solo uso (capturas, grabaciones): scenes/dev/tmp_* y
# scripts/dev/tmp_* se quedan en el disco, no van a git.
scenes/dev/tmp_*
scripts/dev/tmp_*
