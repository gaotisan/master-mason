config_version=5

[application]
config/name="Horror IA Project"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.x", "Forward Plus")

[display]
window/size/viewport_width=2912
window/size/viewport_height=1632
window/size/mode=4
window/size/resizable=false
window/size/borderless=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
viewport/transparent_background=false
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
renderer/rendering_method="forward_plus"

[autoload]
GlobalExit="*res://scripts/main.gd"
